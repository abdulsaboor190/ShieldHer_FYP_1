<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_background">

    <!-- Loading State -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator"
        style="@style/ShieldHer.Widget.LoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Error State -->
    <com.shieldher.dashboard.common.ErrorStateView
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Content State -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sh_space_16"
            android:paddingEnd="@dimen/sh_space_16"
            android:paddingTop="@dimen/sh_space_16"
            android:paddingBottom="@dimen/sh_space_32">

            <!-- Section 1: In-memory Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sh_card"
                app:cardCornerRadius="@dimen/sh_radius_card"
                app:strokeColor="@color/sh_outline"
                app:strokeWidth="@dimen/sh_stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sh_space_16">

                    <TextView
                        style="@style/ShieldHer.TextAppearance.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_preview_heading" />

                    <!-- Preview Frame -->
                    <FrameLayout
                        android:id="@+id/preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/sh_touch_min"
                        android:layout_marginTop="@dimen/sh_space_8">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/preview_loading"
                            style="@style/ShieldHer.Widget.LoadingIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/preview_image"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/detail_preview_image_desc"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/preview_text"
                            style="@style/ShieldHer.TextAppearance.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="10"
                            android:scrollbars="vertical"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/preview_fallback"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Verification Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_16"
                app:cardBackgroundColor="@color/sh_card"
                app:cardCornerRadius="@dimen/sh_radius_card"
                app:strokeColor="@color/sh_outline"
                app:strokeWidth="@dimen/sh_stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sh_space_16">

                    <!-- Badge and Checked Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.shieldher.dashboard.common.StatusBadge
                            android:id="@+id/verification_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/text_checked_time"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/sh_space_8"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Explanation texts -->
                    <TextView
                        android:id="@+id/text_verification_note"
                        style="@style/ShieldHer.TextAppearance.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:visibility="gone" />

                    <!-- Expandable 'What does this mean?' -->
                    <LinearLayout
                        android:id="@+id/layout_meaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/button_toggle_meaning"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sh_primary"
                            android:text="@string/detail_meaning_toggle"
                            android:minHeight="@dimen/sh_touch_min"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/text_meaning_body"
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4"
                            android:text="@string/block_unchanged_meaning"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Verify Button & Progress -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_12">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_verify"
                            style="@style/ShieldHer.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_action_verify" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/verify_progress"
                            style="@style/ShieldHer.Widget.LoadingIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Metadata Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_16"
                app:cardBackgroundColor="@color/sh_card"
                app:cardCornerRadius="@dimen/sh_radius_card"
                app:strokeColor="@color/sh_outline"
                app:strokeWidth="@dimen/sh_stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sh_space_16">

                    <!-- Row 1: Full SHA-256 Hash with Copy -->
                    <LinearLayout
                        android:id="@+id/row_hash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/ShieldHer.TextAppearance.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/detail_hash_label" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_copy_hash"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/sh_touch_min"
                                android:text="@string/detail_copy_hash"
                                android:textColor="@color/sh_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_hash_value"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4"
                            android:textIsSelectable="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sh_stroke_thin"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:layout_marginBottom="@dimen/sh_space_8"
                        android:background="@color/sh_outline" />

                    <!-- Row 2: Received time + Wording Block 2 -->
                    <LinearLayout
                        android:id="@+id/row_received_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_received" />

                        <TextView
                            android:id="@+id/text_received_time_value"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4" />

                        <TextView
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4"
                            android:text="@string/block_time" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sh_stroke_thin"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:layout_marginBottom="@dimen/sh_space_8"
                        android:background="@color/sh_outline" />

                    <!-- Row 3: Source -->
                    <LinearLayout
                        android:id="@+id/row_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_source_label" />

                        <TextView
                            android:id="@+id/text_source_value"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sh_stroke_thin"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:layout_marginBottom="@dimen/sh_space_8"
                        android:background="@color/sh_outline" />

                    <!-- Row 4: File Type -->
                    <LinearLayout
                        android:id="@+id/row_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_type_label" />

                        <TextView
                            android:id="@+id/text_type_value"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sh_stroke_thin"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:layout_marginBottom="@dimen/sh_space_8"
                        android:background="@color/sh_outline" />

                    <!-- Row 5: Stored Size (Encrypted) -->
                    <LinearLayout
                        android:id="@+id/row_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ShieldHer.TextAppearance.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_stored_size_label" />

                        <TextView
                            android:id="@+id/text_size_value"
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Linked Cases Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_linked_cases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_16"
                app:cardBackgroundColor="@color/sh_card"
                app:cardCornerRadius="@dimen/sh_radius_card"
                app:strokeColor="@color/sh_outline"
                app:strokeWidth="@dimen/sh_stroke_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sh_space_16">

                    <TextView
                        style="@style/ShieldHer.TextAppearance.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_linked_cases_heading" />

                    <!-- Cases list container -->
                    <LinearLayout
                        android:id="@+id/container_cases_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:orientation="vertical" />

                    <!-- Empty text -->
                    <TextView
                        android:id="@+id/text_no_linked_cases"
                        style="@style/ShieldHer.TextAppearance.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:text="@string/detail_no_linked_cases"
                        android:visibility="gone" />

                    <!-- Unreadable / error text -->
                    <TextView
                        android:id="@+id/text_cases_unreadable"
                        style="@style/ShieldHer.TextAppearance.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_8"
                        android:text="@string/detail_cases_unreadable"
                        android:visibility="gone" />

                    <!-- Add to case action button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_to_case"
                        style="@style/ShieldHer.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sh_space_12"
                        android:text="@string/detail_action_add_to_case" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 5: Destructive Actions -->
            <FrameLayout
                android:id="@+id/container_detail_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_16">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_delete_evidence"
                    style="@style/ShieldHer.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_action_delete" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
