<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/sh_space_24">

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="@dimen/sh_icon_large"
        android:layout_height="@dimen/sh_icon_large"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sh_space_16"
        android:gravity="center"
        android:textAppearance="@style/ShieldHer.TextAppearance.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sh_space_16"
        android:visibility="gone" />

</LinearLayout>
