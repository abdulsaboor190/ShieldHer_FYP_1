<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/sh_space_16"
    android:layout_marginEnd="@dimen/sh_space_16"
    android:layout_marginBottom="@dimen/sh_space_12"
    app:cardBackgroundColor="@color/sh_card"
    app:cardCornerRadius="@dimen/sh_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/sh_outline_variant"
    app:strokeWidth="@dimen/sh_stroke_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sh_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_time_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/ShieldHer.TextAppearance.Caption"
                tools:text="Received by ShieldHer: 14 Nov 2026, 12:45 UTC" />

            <ImageButton
                android:id="@+id/btn_item_options"
                android:layout_width="@dimen/sh_touch_min"
                android:layout_height="@dimen/sh_touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/case_options_description"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/sh_text_secondary" />

        </LinearLayout>

        <!-- EvidenceCardView -->
        <com.shieldher.dashboard.common.EvidenceCardView
            android:id="@+id/card_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sh_space_8" />

        <!-- Optional note -->
        <TextView
            android:id="@+id/text_item_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sh_space_8"
            android:textAppearance="@style/ShieldHer.TextAppearance.BodySmall"
            android:textColor="@color/sh_text_secondary"
            android:visibility="gone"
            tools:text="This is an attached note regarding the incident."
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
