<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/sh_space_16"
    android:paddingEnd="@dimen/sh_space_16"
    android:paddingTop="@dimen/sh_space_24"
    android:paddingBottom="@dimen/sh_space_24">

    <!-- Row 1: Settings and privacy -->
    <LinearLayout
        android:id="@+id/row_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sh_touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/sh_space_8"
        android:paddingEnd="@dimen/sh_space_8"
        android:contentDescription="@string/title_settings">

        <TextView
            style="@style/ShieldHer.TextAppearance.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_settings" />

        <ImageView
            android:layout_width="@dimen/sh_icon_medium"
            android:layout_height="@dimen/sh_icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/sh_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sh_stroke_thin"
        android:background="@color/sh_outline"
        android:layout_marginTop="@dimen/sh_space_4"
        android:layout_marginBottom="@dimen/sh_space_4" />

    <!-- Row 2: Account Check -->
    <LinearLayout
        android:id="@+id/row_account_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sh_touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/sh_space_8"
        android:paddingEnd="@dimen/sh_space_8"
        android:contentDescription="@string/title_account_check">

        <TextView
            style="@style/ShieldHer.TextAppearance.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_account_check" />

        <ImageView
            android:layout_width="@dimen/sh_icon_medium"
            android:layout_height="@dimen/sh_icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/sh_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sh_stroke_thin"
        android:background="@color/sh_outline"
        android:layout_marginTop="@dimen/sh_space_4"
        android:layout_marginBottom="@dimen/sh_space_4" />

    <!-- Row 3: Welcome guide -->
    <LinearLayout
        android:id="@+id/row_welcome_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sh_touch_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/sh_space_8"
        android:paddingEnd="@dimen/sh_space_8"
        android:contentDescription="@string/title_welcome_guide">

        <TextView
            style="@style/ShieldHer.TextAppearance.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_welcome_guide" />

        <ImageView
            android:layout_width="@dimen/sh_icon_medium"
            android:layout_height="@dimen/sh_icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/sh_text_secondary" />
    </LinearLayout>

</LinearLayout>
