<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_background"
    android:orientation="vertical">

    <!-- Header area with Search Bar and Import Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sh_space_16"
        android:paddingEnd="@dimen/sh_space_16"
        android:paddingTop="@dimen/sh_space_12"
        android:paddingBottom="@dimen/sh_space_8">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_search"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/evidence_list_search_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/sh_text_secondary"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_import"
            style="@style/ShieldHer.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sh_space_8"
            android:text="@string/evidence_list_action_import" />
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading_indicator"
            style="@style/ShieldHer.Widget.LoadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Empty state view (no items or no search matches) -->
        <com.shieldher.dashboard.common.EmptyStateView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Error state view -->
        <com.shieldher.dashboard.common.ErrorStateView
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- RecyclerView of evidence items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_evidence"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/sh_space_8"
            android:paddingBottom="@dimen/sh_space_16"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
