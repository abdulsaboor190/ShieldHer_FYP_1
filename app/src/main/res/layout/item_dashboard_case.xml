<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/sh_space_16"
    android:layout_marginEnd="@dimen/sh_space_16"
    android:layout_marginBottom="@dimen/sh_space_8"
    app:cardBackgroundColor="@color/sh_card"
    app:cardCornerRadius="@dimen/sh_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/sh_outline_variant"
    app:strokeWidth="@dimen/sh_stroke_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/sh_space_16">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_case_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sh_space_4"
                android:textAppearance="@style/ShieldHer.TextAppearance.Heading"
                tools:text="Work incident report" />

            <TextView
                android:id="@+id/text_case_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sh_space_8"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/ShieldHer.TextAppearance.BodySmall"
                tools:text="Notes from internal company chat and emails" />

            <TextView
                android:id="@+id/text_case_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/ShieldHer.TextAppearance.Caption"
                tools:text="14 Nov 2026, 12:45 UTC" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_case_options"
            android:layout_width="@dimen/sh_touch_min"
            android:layout_height="@dimen/sh_touch_min"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/case_options_description"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/sh_text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
