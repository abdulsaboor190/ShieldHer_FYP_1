<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sh_space_24"
    android:paddingTop="@dimen/sh_space_16"
    android:paddingEnd="@dimen/sh_space_24"
    android:paddingBottom="@dimen/sh_space_16">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_select_evidence"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sh_space_16"
        android:hint="@string/dialog_add_evidence_select_label">

        <AutoCompleteTextView
            android:id="@+id/dropdown_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="none"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_evidence_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sh_space_16"
        android:hint="@string/dialog_input_note_optional_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_evidence_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textNoSuggestions|textMultiLine"
            android:minLines="2"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_selected_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_input_date_hint"
            android:textAppearance="@style/ShieldHer.TextAppearance.BodySmall"
            android:textColor="@color/sh_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_date"
            style="@style/ShieldHer.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_action_pick_date" />

    </LinearLayout>

</LinearLayout>
