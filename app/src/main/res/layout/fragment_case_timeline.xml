<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header buttons layout: Add evidence & Add note -->
    <LinearLayout
        android:id="@+id/timeline_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sh_space_16"
        android:paddingTop="@dimen/sh_space_16"
        android:paddingEnd="@dimen/sh_space_16"
        android:paddingBottom="@dimen/sh_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_evidence"
            style="@style/ShieldHer.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sh_space_8"
            android:layout_weight="1"
            android:text="@string/timeline_action_add_evidence" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_note"
            style="@style/ShieldHer.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sh_space_8"
            android:layout_weight="1"
            android:text="@string/timeline_action_add_note" />

    </LinearLayout>

    <!-- Timeline RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/sh_space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeline_header_layout"
        tools:listitem="@layout/item_timeline_evidence" />

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_loading"
        style="@style/ShieldHer.Widget.LoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeline_header_layout"
        tools:visibility="visible" />

    <!-- Empty State -->
    <com.shieldher.dashboard.common.EmptyStateView
        android:id="@+id/empty_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeline_header_layout"
        tools:visibility="gone" />

    <!-- Error State -->
    <com.shieldher.dashboard.common.ErrorStateView
        android:id="@+id/error_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeline_header_layout"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
