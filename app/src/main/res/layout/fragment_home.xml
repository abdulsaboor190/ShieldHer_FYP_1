<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_background">

    <!-- Loading State -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator"
        style="@style/ShieldHer.Widget.LoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Error State -->
    <com.shieldher.dashboard.common.ErrorStateView
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Empty State -->
    <com.shieldher.dashboard.common.EmptyStateView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Content State -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sh_space_16"
            android:paddingEnd="@dimen/sh_space_16"
            android:paddingTop="@dimen/sh_space_24"
            android:paddingBottom="@dimen/sh_space_32">

            <!-- Heading & Welcome line -->
            <TextView
                android:id="@+id/text_heading"
                style="@style/ShieldHer.TextAppearance.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_heading" />

            <TextView
                android:id="@+id/text_welcome"
                style="@style/ShieldHer.TextAppearance.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_4"
                android:text="@string/home_welcome" />

            <!-- Two summary cards side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_24"
                android:orientation="horizontal">

                <!-- Evidence count card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_evidence_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/sh_space_8"
                    app:cardBackgroundColor="@color/sh_card"
                    app:cardCornerRadius="@dimen/sh_radius_card"
                    app:strokeColor="@color/sh_outline"
                    app:strokeWidth="@dimen/sh_stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/sh_space_16">

                        <TextView
                            android:id="@+id/text_evidence_count"
                            style="@style/ShieldHer.TextAppearance.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4"
                            android:text="@string/home_stat_evidence_label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Case count card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_case_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/sh_space_8"
                    app:cardBackgroundColor="@color/sh_card"
                    app:cardCornerRadius="@dimen/sh_radius_card"
                    app:strokeColor="@color/sh_outline"
                    app:strokeWidth="@dimen/sh_stroke_thin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/sh_space_16">

                        <TextView
                            android:id="@+id/text_case_count"
                            style="@style/ShieldHer.TextAppearance.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/ShieldHer.TextAppearance.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sh_space_4"
                            android:text="@string/home_stat_cases_label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Latest Evidence Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ShieldHer.TextAppearance.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_section_latest_evidence" />

                <TextView
                    android:id="@+id/action_see_all"
                    style="@style/ShieldHer.TextAppearance.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/sh_touch_min"
                    android:gravity="center_vertical"
                    android:textColor="@color/sh_primary"
                    android:text="@string/home_action_see_all" />
            </LinearLayout>

            <!-- Container for up to 3 EvidenceCardViews -->
            <LinearLayout
                android:id="@+id/latest_cards_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_8"
                android:orientation="vertical" />

            <!-- Primary button: Import evidence -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_import"
                style="@style/ShieldHer.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sh_space_24"
                android:text="@string/home_action_import" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
