<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sh_space_24"
    android:paddingTop="@dimen/sh_space_16"
    android:paddingEnd="@dimen/sh_space_24"
    android:paddingBottom="@dimen/sh_space_16">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_case_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sh_space_16"
        android:hint="@string/dialog_new_case_input_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_case_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textNoSuggestions"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_case_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_new_case_input_description">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_case_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textNoSuggestions|textMultiLine"
            android:minLines="2"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
