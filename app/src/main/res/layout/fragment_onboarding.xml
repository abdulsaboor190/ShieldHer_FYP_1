<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_background">

    <!-- Skip button (top-right, hidden on last page) -->
    <Button
        android:id="@+id/btn_skip"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sh_touch_min"
        android:layout_marginEnd="@dimen/sh_space_8"
        android:layout_marginTop="@dimen/sh_space_8"
        android:text="@string/onboarding_action_skip"
        android:textAppearance="@style/ShieldHer.TextAppearance.Body"
        android:textColor="@color/sh_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ViewPager2 fills space between top controls and bottom nav -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_onboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/text_page_indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_skip" />

    <!-- Page indicator (e.g. "1 of 3") -->
    <TextView
        android:id="@+id/text_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sh_space_16"
        android:textAppearance="@style/ShieldHer.TextAppearance.Caption"
        android:textColor="@color/sh_text_secondary"
        app:layout_constraintBottom_toTopOf="@id/barrier_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1 of 3" />

    <!-- Barrier to anchor button row -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="btn_back,btn_next" />

    <!-- Back button (gone on first page) -->
    <Button
        android:id="@+id/btn_back"
        style="@style/ShieldHer.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/sh_touch_min"
        android:layout_marginStart="@dimen/sh_space_16"
        android:layout_marginEnd="@dimen/sh_space_8"
        android:layout_marginBottom="@dimen/sh_space_32"
        android:text="@string/onboarding_action_back"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Next / Get Started button -->
    <Button
        android:id="@+id/btn_next"
        style="@style/ShieldHer.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/sh_touch_min"
        android:layout_marginStart="@dimen/sh_space_8"
        android:layout_marginEnd="@dimen/sh_space_16"
        android:layout_marginBottom="@dimen/sh_space_32"
        android:text="@string/onboarding_action_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back" />

</androidx.constraintlayout.widget.ConstraintLayout>
