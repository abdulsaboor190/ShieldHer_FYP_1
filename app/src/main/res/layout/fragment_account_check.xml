<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/account_check_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sh_space_16"
        android:paddingBottom="@dimen/sh_space_32">

        <!-- Intro explanation -->
        <TextView
            android:id="@+id/text_risk_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_24"
            android:text="@string/risk_intro"
            android:textAppearance="@style/ShieldHer.TextAppearance.Body"
            android:textColor="@color/sh_text_secondary" />

        <!-- Platform selector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_8"
            android:text="@string/account_check_platform_label"
            android:textAppearance="@style/ShieldHer.TextAppearance.Heading" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_platform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_instagram"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/account_check_platform_instagram" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_x"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/account_check_platform_x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_other"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/account_check_platform_other" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Platform not chosen inline alert -->
        <TextView
            android:id="@+id/text_platform_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:text="@string/risk_choose_platform"
            android:textAppearance="@style/ShieldHer.TextAppearance.BodySmall"
            android:textColor="@color/sh_status_warning_text"
            android:visibility="gone" />

        <!-- Followers input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_followers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:hint="@string/account_check_followers_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_followers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:saveEnabled="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Following input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_following"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:hint="@string/account_check_following_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_following"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:saveEnabled="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bio text input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:hint="@string/account_check_bio_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:saveEnabled="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Profile includes link switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/account_check_has_link_label"
                android:textAppearance="@style/ShieldHer.TextAppearance.Body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_has_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sh_space_16"
                android:saveEnabled="false" />

        </LinearLayout>

        <!-- Action buttons row: Run check and Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_check"
                style="@style/ShieldHer.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/sh_space_8"
                android:layout_weight="1"
                android:text="@string/risk_button_run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/risk_button_clear" />

        </LinearLayout>

        <!-- Loading indicator during computation -->
        <ProgressBar
            android:id="@+id/progress_computing"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:visibility="gone" />

        <!-- Result container (hidden until Done) -->
        <LinearLayout
            android:id="@+id/container_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_24"
            android:accessibilityLiveRegion="polite"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.shieldher.dashboard.check.RiskStatusBadge
                android:id="@+id/badge_risk_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sh_space_12" />

            <TextView
                android:id="@+id/text_risk_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sh_space_8"
                android:textAppearance="@style/ShieldHer.TextAppearance.Heading" />

            <TextView
                android:id="@+id/text_risk_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sh_space_12"
                android:textAppearance="@style/ShieldHer.TextAppearance.Body"
                android:textColor="@color/sh_text_secondary" />

            <TextView
                android:id="@+id/text_risk_model_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/risk_model_line"
                android:textAppearance="@style/ShieldHer.TextAppearance.BodySmall"
                android:textColor="@color/sh_text_secondary" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/sh_stroke_thin"
            android:layout_marginBottom="@dimen/sh_space_24"
            android:background="@color/sh_outline_variant" />

        <!-- Limits of this check (ALWAYS visible) -->
        <TextView
            android:id="@+id/text_risk_limits_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_8"
            android:text="@string/risk_limits_heading"
            android:textAppearance="@style/ShieldHer.TextAppearance.Heading" />

        <TextView
            android:id="@+id/text_risk_limits_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_16"
            android:text="@string/risk_limits_body"
            android:textAppearance="@style/ShieldHer.TextAppearance.Body"
            android:textColor="@color/sh_text_secondary" />

        <!-- Expandable How well does this work? toggle -->
        <TextView
            android:id="@+id/text_about_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_8"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/risk_about_toggle"
            android:textAppearance="@style/ShieldHer.TextAppearance.Heading"
            android:textColor="@color/sh_primary" />

        <TextView
            android:id="@+id/text_about_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sh_space_24"
            android:text="@string/risk_about_body"
            android:textAppearance="@style/ShieldHer.TextAppearance.Body"
            android:textColor="@color/sh_text_secondary"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
