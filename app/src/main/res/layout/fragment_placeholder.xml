<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/sh_space_24">

    <TextView
        android:id="@+id/text_title"
        style="@style/ShieldHer.TextAppearance.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/text_note"
        style="@style/ShieldHer.TextAppearance.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sh_space_8"
        android:gravity="center"
        android:text="@string/placeholder_screen_note" />

</LinearLayout>
