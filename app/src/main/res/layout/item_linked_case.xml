<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sh_touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/sh_space_12"
    android:paddingEnd="@dimen/sh_space_12"
    android:paddingTop="@dimen/sh_space_8"
    android:paddingBottom="@dimen/sh_space_8">

    <TextView
        android:id="@+id/text_case_title"
        style="@style/ShieldHer.TextAppearance.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="@dimen/sh_icon_medium"
        android:layout_height="@dimen/sh_icon_medium"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/sh_text_secondary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
